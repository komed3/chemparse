{
  "name": "chemparse",
  "description": "Chemical formula parser; supports nested parentheses, decimal and scientific notation, dot-separated hydrate parts, IUPAC symbol validation",
  "license": "MIT",
  "version": "1.0.4",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://github.com/komed3/chemparse",
  "keywords": [
    "chemistry",
    "chemistry-formulas",
    "formula-parser",
    "formula",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komed3/chemparse.git"
  },
  "bugs": {
    "url": "https://github.com/komed3/chemparse/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/chemparse.d.ts",
  "main": "./dist/chemparse.cjs",
  "module": "./dist/chemparse.mjs",
  "exports": {
    ".": {
      "types": "./dist/chemparse.d.ts",
      "require": "./dist/chemparse.cjs",
      "import": "./dist/chemparse.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json && mv ./dist/chemparse.js ./dist/chemparse.cjs",
    "build:esm": "tsc -p tsconfig.esm.json && mv ./dist/chemparse.js ./dist/chemparse.mjs",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "npm run build:cjs && npm run build:esm && npm run build:dts",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*\" --log-level warn",
    "build": "npm run clean && npm run build:all && npm run format",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
