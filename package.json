{
  "name": "chemparse",
  "description": "TypeScript parser for chemical formulas and particle expressions with ionic charges, composition comparison, and differences.",
  "license": "MIT",
  "version": "1.2.1",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://komed3.github.io/chemistry",
  "keywords": [
    "chemistry",
    "chemical-formula",
    "formula-parser",
    "chemical-parser",
    "particle-physics",
    "particle-parser",
    "subatomic-particles",
    "ionic-charge",
    "stoichiometry",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komed3/chemparse.git"
  },
  "bugs": {
    "url": "https://github.com/komed3/chemparse/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/chemparse.d.ts",
  "main": "./dist/chemparse.cjs",
  "module": "./dist/chemparse.mjs",
  "exports": {
    ".": {
      "types": "./dist/chemparse.d.ts",
      "require": "./dist/chemparse.cjs",
      "import": "./dist/chemparse.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').renameSync('dist/chemparse.js', 'dist/chemparse.cjs')\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').renameSync('dist/chemparse.js', 'dist/chemparse.mjs')\"",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "npm run build:cjs && npm run build:esm && npm run build:dts",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*\" --log-level warn",
    "build": "npm run clean && npm run build:all && npm run format",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2"
  }
}
